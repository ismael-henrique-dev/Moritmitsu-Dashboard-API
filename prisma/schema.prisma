generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enum de papéis (roles) disponíveis
enum RoleName {
  admin
  instructor
}

// Enum de faixas (belts) de Jiu-Jitsu
enum Belt {
  white
  blue
  purple
  brown
  black
}

// Enum de preferências de graduação
enum GraduationCategory {
  belt
  grade
}

// Enum de dias da semana para os horários das aulas
enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

// Tabela de usuários
model User {
  id       String @id @default(uuid())
  username String
  email    String @unique
  password String

  role_id String
  role    Role   @relation(fields: [role_id], references: [id])

  classes Classes[] @relation("InstructorClasses")

  @@map("users")
}

// Tabela de papéis (roles)
model Role {
  id   String   @id @default(uuid())
  name RoleName @unique

  users             User[]
  role_permissions  RolePermission[]

  @@map("roles")
}

// Tabela de permissões
model Permission {
  id          String @id @default(uuid())
  code        String @unique
  description String?

  role_permissions RolePermission[]

  @@map("permissions")
}

// Tabela de associação entre Roles e Permissions
model RolePermission {
  role_id       String
  permission_id String

  role       Role       @relation(fields: [role_id], references: [id])
  permission Permission @relation(fields: [permission_id], references: [id])

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

// Tabela de alunos
model Student {
  id String @id @default(uuid())

  alias             String?
  belt              Belt
  grade             Int
  current_training  Int @default(0)
  total_trainings   Int @default(0)

  personal_info StudentPersonalInfo?
  graduations   Graduation[]
  enrollments   Enrollment[]

  @@map("students")
}

// Tabela de informações pessoais dos alunos
model StudentPersonalInfo {
  id String @id @default(uuid())

  email         String   @unique
  full_name     String
  date_of_birth DateTime
  cpf           String   @unique @db.Char(11)
  address       String

  student_phone String
  parent_phone  String?
  parent_name   String?

  student_id String @unique
  student    Student @relation(fields: [student_id], references: [id])

  @@map("student_personal_info")
}

// Tabela de graduações dos alunos
model Graduation {
  id String @id @default(uuid())

  belt  Belt?
  grade Int?
  date  DateTime

  student_id String
  student    Student @relation(fields: [student_id], references: [id])

  @@map("graduations")
}

// Tabela de preferências de graduação
model GraduationPreference {
  id String @id @default(uuid())

  category            GraduationCategory
  min_age             Int
  max_age             Int?
  necessary_training  Int

  @@map("graduations_preferences")
}

// Tabela das turmas oferecidas
model Classes {
  id String @id @default(uuid())

  name     String
  min_age  Int
  max_age  Int?

  instructor_id String
  instructor    User @relation("InstructorClasses", fields: [instructor_id], references: [id])

  schedules   ClassSchedule[]
  enrollments Enrollment[]

  @@map("classes")
}

// Tabela de horários das aulas
model ClassSchedule {
  id String @id @default(uuid())

  day_of_week DayOfWeek
  time        DateTime @db.Time

  class_id String
  class    Classes @relation(fields: [class_id], references: [id])

  @@map("class_schedules")
}

// Tabela de associação entre Students e Classes (Alunos enturmados)
model Enrollment {
  student_id String
  class_id   String

  student Student @relation(fields: [student_id], references: [id])
  class   Classes @relation(fields: [class_id], references: [id])

  @@id([student_id, class_id])
  @@map("enrollments")
}
